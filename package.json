{
  "name": "leya-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Leya Phase 1 backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs fast",
    "start": "node dist/server.js",
    "test:integration": "node scripts/run-tests.mjs full",
    "eval:dialogs": "npm run build && node dist/scripts/eval-dialogs.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/postgrest-js": "2.108.2",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mammoth": "1.11.0",
    "music-metadata": "11.15.0",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/pdf-parse": "1.1.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "yaml": "^2.9.1"
  }
}
